        Dashboard

    </MudNavLink>

@*     <MudText Typo="Typo.overline" Class="px-4 pt-4">
        Verwaltung
    </MudText> *@

    <MudNavLink Href="/tournaments"
                Icon="@Icons.Material.Filled.EmojiEvents">

        Turniere

    </MudNavLink>

    <MudNavLink Href="/players"
                Icon="@Icons.Material.Filled.Groups">

        Spieler

    </MudNavLink>

    <MudNavLink Href="/matches"
                Icon="@Icons.Material.Filled.SportsTennis">

        Matches

    </MudNavLink>

