@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <MudAppBar Elevation="1">
        
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.SportsTennis" Class="me-2" />
            TennisManager
        </MudText>

        <MudSpacer />

        <UserMenu/>

    </MudAppBar>

    <MudDrawer Open="true"
               Elevation="1"
               ClipMode="DrawerClipMode.Always">

        <NavMenu />

    </MudDrawer>

    <MudMainContent>

        <MudContainer MaxWidth="MaxWidth.False"
                      Class="pa-4">

            @Body

        </MudContainer>

    </MudMainContent>

</MudLayout>

<form id="logoutForm"
      action="Account/Logout"
      method="post"
      style="display:none">

    <AntiforgeryToken />

    <input type="hidden"
           name="ReturnUrl"
           value="" />

    <button type="submit"></button>

</form>

