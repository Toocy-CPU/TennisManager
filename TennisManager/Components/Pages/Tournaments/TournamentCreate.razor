@page "/tournaments/create"
@using System.Security.Claims
@using TennisManager.Models
@using TennisManager.Services
@inject TournamentService TournamentService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Neues Turnier</PageTitle>

<MudPaper Class="pa-4">

    <MudText Typo="Typo.h4">
        Neues Turnier
    </MudText>

    <MudForm>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField Label="Turniername"
                    @bind-Value="Tournament.Name"
                    Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudDatePicker Label="Startdatum"
					@bind-Date="Tournament.StartDate"
                    Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" md="6">

                <MudDatePicker Label="Anmeldeschluss"
                               @bind-Date="Tournament.RegistrationEnds"
                               Variant="Variant.Outlined" />

            </MudItem>

            

            <MudItem xs="12" md="6">

                <MudTextField Label="Ort"
                    @bind-Value="Tournament.Location"
                    Variant="Variant.Outlined" />

            </MudItem>

            <MudItem xs="12" md="6">

                <MudNumericField T="int"
                                 Label="Rundendauer (Tage)"
                                 @bind-Value="Tournament.RoundDurationInDays"
                                 Variant="Variant.Outlined"
                                 Min="1" />

            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="TournamentMode"
                           Label="Modus" @bind-Value="Tournament.Mode"
                           Variant="Variant.Outlined">
                    @foreach (var mode in Enum.GetValues<TournamentMode>())
                    {
                        <MudSelectItem Value="@mode">
                            @mode
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudNumericField T="int"
                    Label="Max. Teilnehmer"
                    @bind-Value="Tournament.MaxPlayers"
                    Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12">

                <MudTextField Label="Beschreibung"
                              Lines="4"
                              @bind-Value="Tournament.Description"
                              Variant="Variant.Outlined" />

            </MudItem>

            <MudItem xs="12">
                <MudStack Row="true"
                    Justify="Justify.FlexEnd"
                    Spacing="2">

                    <MudButton Variant="Variant.Text"
                        OnClick="CancelCreateTournament">
                        Abbrechen
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                        Color="Color.Primary" 
                        OnClick="SaveTournament">
                        Speichern
                    </MudButton>

                </MudStack>
            </MudItem>
        </MudGrid>

    </MudForm>

</MudPaper>

@code {
    private Tournament Tournament = new();

    // works for now but on a longterm the form should be submitted with the button to validate fields
    private async Task SaveTournament()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (userId is null)
        {
            return;
        }

        Tournament.CreatedByUserId = userId;

        await TournamentService.CreateTournamentAsync(Tournament);

        Navigation.NavigateTo("/Tournaments");
    }
    private void CancelCreateTournament()
    {
        Navigation.NavigateTo("/Tournaments");
    }
}
