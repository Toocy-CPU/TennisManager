@using TennisManager.Components.Shared
@using TennisManager.Models
@using TennisManager.Services
@inject TournamentService TournamentService
@inject TournamentBracketService TournamentBracketService
@inject IDialogService DialogService

@if (!Matches.Any())
{
    <MudAlert Severity="Severity.Info" Dense="true">
        Noch kein Turnierbaum vorhanden.
    </MudAlert>
}
else
{
    var rounds = Matches
        .GroupBy(m => m.Round)
        .OrderBy(g => g.Key);

    <div class="bracket-container">

        @foreach (var round in rounds)
        {
            var roundIndex = round.Key - 1;

            <div class="round">

                <div class="round-title">

                    <MudText Typo="Typo.h6">
                        @GetRoundName(round.Key)
                    </MudText>

                </div>

                <div class="round-matches level-@roundIndex">

                    @foreach (var match in round)
                    {
                        <MudPaper Class="match-card" Elevation="3"
                                  @onclick="() => OpenResultDialog(match)"
                                  Style="cursor: pointer;">

                            <div class="player @(match.WinnerId == match.PlayerAId ? "winner" : "")">

                                <span class="player-name">
                                    @(match.PlayerA?.FullName ?? "TBD")
                                </span>

                                <div class="scores">
                                    @foreach (var set in match.Sets.OrderBy(s => s.SetNumber))
                                    {
                                        <span class="score">
                                            @(set.TieBreakA ?? set.PlayerAGames)
                                        </span>
                                    }
                                </div>

                            </div>

                            <MudDivider />

                            <div class="player @(match.WinnerId == match.PlayerBId ? "winner" : "")">

                                <span class="player-name">
                                    @(match.PlayerB?.FullName ?? "TBD")
                                </span>

                                <div class="scores">
                                    @foreach (var set in match.Sets.OrderBy(s => s.SetNumber))
                                    {
                                        <span class="score">
                                            @(set.TieBreakB ?? set.PlayerBGames)
                                        </span>
                                    }
                                </div>

                            </div>

                        </MudPaper>
                    }

                </div>

            </div>
        }

    </div>
}

@code {
    [Parameter]
    public List<Match> Matches { get; set; } = [];

    private string GetRoundName(int round)
    {
        var maxRound = Matches.Max(m => m.Round);

        if (round == maxRound)
            return "Finale";

        if (round == maxRound - 1)
            return "Halbfinale";

        if (round == maxRound - 2)
            return "Viertelfinale";

        return $"Runde {round}";
    }

    private async Task OpenResultDialog(Match match)
    {
        var parameters = new DialogParameters<MatchResultDialog>
        {
            { x => x.Match, match }
        };

        var dialog = await DialogService.ShowAsync<MatchResultDialog>(
            "Ergebnis eingeben",
            parameters);

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var setResults = (List<SetResult>)result.Data;

            await TournamentBracketService.SaveMatchResultsAsync(setResults);
        }
    }
}
