@page "/tournaments"
@using TennisManager.Components.Shared
@using TennisManager.Extensions
@using TennisManager.Services
@using TennisManager.Models
@using System.Security.Claims
@inject TournamentService TournamentService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Turniere</PageTitle>

<MudStack Row="true"
          Justify="Justify.SpaceBetween"
          AlignItems="AlignItems.Center"
          Class="mb-4">

    <MudText Typo="Typo.h4">
        Turniere
    </MudText>

    @if (currentUserId is not null)
    {
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="CreateTournament">

            Turnier erstellen

        </MudButton>
    }

</MudStack>

<MudGrid Spacing="3">

    @foreach (var tournament in tournaments)
    {
        <MudItem xs="12" sm="6" lg="4">

            <MudCard>

                <MudCardContent>

                    <MudText Typo="Typo.h6">
                        @tournament.Name
                    </MudText>

                    <MudDivider Class="my-3" />

                    <MudGrid Spacing="2">

                        <MudItem xs="12" sm="6">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Class="me-2" />
                                <MudText>
                                    Start: @tournament.StartDate?.ToShortDateString()
                                </MudText>
                            </MudStack>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.Groups" Class="me-2" />
                                <MudText>
                                    @tournament.Participants.Count / @tournament.MaxPlayers Teilnehmer
                                </MudText>
                            </MudStack>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.EventBusy" Class="me-2" />
                                <MudText>
                                    Anmeldung bis: @tournament.RegistrationEnds?.ToShortDateString()
                                </MudText>
                            </MudStack>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="me-2" />
                                <MudText>
                                    @tournament.RoundDurationInDays Tage pro Runde
                                </MudText>
                            </MudStack>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Class="me-2" />
                                <MudText>
                                    @tournament.Location
                                </MudText>
                            </MudStack>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.SportsTennis" Class="me-2" />
                                <MudText>
                                    @tournament.Mode
                                </MudText>
                            </MudStack>
                        </MudItem>

                    </MudGrid>

                    <MudDivider Class="my-3" />

                    <MudChip T="string"
                             Icon="@tournament.Status.GetIcon()"
                             Color="@tournament.Status.GetColor()"
                             Variant="Variant.Filled"
                             Class="w-100">

                        @tournament.Status.GetText()

                    </MudChip>

                </MudCardContent>

                <MudCardActions>

                    <MudButton Variant="Variant.Text"
                               StartIcon="@Icons.Material.Filled.Visibility"
                               OnClick="() => OpenTournamentDetails(tournament.Id)">

                        Details

                    </MudButton>

                    <MudSpacer />

                    @if (currentUserId is not null)
                    {
                        @if (IsRegistered(tournament))
                        {
                            <MudButton Color="Color.Error"
                                       Variant="Variant.Filled"
                                       OnClick="() => UnregisterFromTournament(tournament.Id)">

                                Abmelden

                            </MudButton>
                        }
                        else
                        {
                            <MudButton Color="Color.Primary"
                                       Variant="Variant.Filled"
                                       OnClick="() => RegisterForTournament(tournament.Id)">

                                Anmelden

                            </MudButton>
                        }
                    }

                </MudCardActions>

            </MudCard>

        </MudItem>
    }

</MudGrid>

@code {
    private List<Tournament> tournaments = [];
    private string? currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        tournaments = await TournamentService.GetTournamentsAsync();
    }

    private void CreateTournament()
    {
        Navigation.NavigateTo("/tournaments/create");
    }
    private void OpenTournamentDetails(int tournamentId)
    {
        Navigation.NavigateTo($"/tournaments/{tournamentId}");
    }

    private async Task RegisterForTournament(int tournamentId)
    {
        if (currentUserId is null)
        {
            return;
        }

        var result = await TournamentService.RegisterPlayerAsync(
            tournamentId,
            currentUserId
        );

        ShowRegistrationResultSnackbar(result);
    }
    private async Task UnregisterFromTournament(int tournamentId)
    {
        if (currentUserId is null)
        {
            return;
        }

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title, "Abmeldung" },
            { x => x.Message, "Möchten Sie sich wirklich vom Turnier abmelden?" },
            { x => x.ConfirmButtonText, "Abmelden"}
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
        title:null,
        parameters);

        var dialogResult = await dialog.Result;
        if (dialogResult is null || dialogResult.Canceled)
        {
            return;
        }

        var registrationResult = await TournamentService.UnregisterPlayerAsync(
            tournamentId,
            currentUserId
        );

        ShowRegistrationResultSnackbar(registrationResult);
    }

    private bool IsRegistered(Tournament tournament)
    {        

        return tournament.Participants.Any(p => p.UserId == currentUserId);

        // tournament cant be Null bcs we use this in a foreach over tournaments so it
        //  would never be called if no tournarment is there
        //return tournament?.Participants.Any(p => p.UserId == currentUserId) ?? false;
    }
    private void ShowRegistrationResultSnackbar(RegistrationResult result)
    {
        switch (result)
        {
            case RegistrationResult.Registered:
                Snackbar.Add($"Erfolgreich am Turnier angemeldet",
                    Severity.Success);
                break;
            case RegistrationResult.Unregistered:
                Snackbar.Add("Erfolgreich vom Turnier abgemeldet",
                    Severity.Success);
                break;
            case RegistrationResult.AlreadyRegistered:
                Snackbar.Add("Bereits am Turnier angemeldet",
                    Severity.Info);
                break;
            case RegistrationResult.RegistrationClosed:
                Snackbar.Add("Anmeldung geschlossen",
                    Severity.Warning);
                break;
            case RegistrationResult.PlayerNotFound:
                Snackbar.Add("Spieler nicht gefunden",
                    Severity.Warning);
                break;
            case RegistrationResult.TournamentFull:
                Snackbar.Add("Das Turnier ist bereits voll",
                    Severity.Warning);
                break;
            case RegistrationResult.TournamentNotFound:
                Snackbar.Add("Turnier nicht gefunden",
                    Severity.Error);
                    break;
        }
    }
}
